# Normalise text in the repository, decide line endings on checkout.
* text=auto

# Windows shell scripts must be CRLF: cmd.exe can mis-parse labels and goto in
# a batch file that only has LF endings.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Source, docs and data keep LF.
*.c     text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.hlsl  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.manifest text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Never touch these.
*.png   binary
*.jpg   binary
*.ico   binary
*.exe   binary
*.pdb   binary
*.gz    binary

# Measurement data is generated, not authored: mark it so review tools collapse
# it and it does not skew the repository's language stats. The small histogram
# and summary CSVs still diff normally; only the compressed sample table, which
# is genuinely binary, is excluded.
results/**/raw/*.csv    linguist-generated=true
results/**/raw/*.csv.gz linguist-generated=true -diff
